#!/bin/bash
# 제작을 일시정지합니다. 돌고 있던 종목은 끝까지 만들고, 새 종목은 시작하지 않습니다.
cd "$(dirname "$0")/.."
[ -f ./파이썬고르기.sh ] && . ./파이썬고르기.sh
touch 일시정지.flag
echo "⏸ 일시정지 표시를 걸었습니다."
echo
echo "  · 지금 만들고 있던 종목은 끝까지 만든 뒤 멈춥니다 (도중에 버리지 않습니다)."
echo "  · 아직 시작 안 한 종목은 그대로 남습니다."
echo "  · 다시 시작하려면 '8_이어서_제작' 을 누르세요."
echo
echo "  급하게 지금 당장 끊어야 하면 제작이 돌고 있는 터미널 창에서 Control + C 를 누르세요."
echo "  그 경우 만들던 종목 하나는 버려지지만, 다음 실행에서 처음부터 다시 만듭니다."
echo
read -n 1 -s -r -p "아무 키나 누르면 닫힙니다."
