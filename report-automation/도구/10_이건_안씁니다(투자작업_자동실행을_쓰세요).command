#!/bin/bash
# 2026-09-05 — 이 단추는 이제 쓰지 않습니다.
#
# 아침 시황·전략은 「투자 작업 자동실행」에 들어갔고, 시각도 **평일 오전 8시**로 옮겼습니다.
# (증권사 리포트를 먼저 받아 온 뒤에 보고서를 쓰기 때문입니다)
#
# 켜고 끄기는 TM26 앱에서 하십시오:
#   TM26 앱 → 4. 자동실행 설정 → 「투자 작업 자동실행 켜기」
#
# 거기서 이렇게 걸립니다.
#   시황·전략 8:00 · 장전 브리핑 8:40 · 미국 종목 10:30
#   한국 종목 15:30 · 매매평가 16:30 · 주간 복기 토 12:00
OLD="$HOME/Library/LaunchAgents/com.jun.stockreport.morning.plist"
if [ -f "$OLD" ]; then
  launchctl unload "$OLD" 2>/dev/null; rm -f "$OLD"
  echo "겹치던 옛 7시 예약을 치웠습니다."
fi
echo
echo "이 단추는 더 쓰지 않습니다. TM26 앱 → 4. 자동실행 설정 → 「투자 작업 자동실행 켜기」 를 쓰세요."
echo
read -n 1 -s -r -p "아무 키나 누르면 닫힙니다."
