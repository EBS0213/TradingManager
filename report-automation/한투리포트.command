#!/bin/bash
# 한국투자증권 리서치를 받아 옵니다. 파인더에서 두 번 누르면 됩니다. (2026-09-14 신설)
#
#   ① 새로 올라온 리서치 목록을 받습니다 (로그인 없이 됩니다)
#   ② 로그인 창이 뜨면 **직접 로그인**하십시오 — 보안키보드라 사람이 쳐야 합니다
#   ③ 그 뒤 밀린 원문 PDF 를 한꺼번에 받아 입력 폴더에 넣습니다
#   ④ 기업 리포트는 종목 폴더까지 넣어 둡니다
#
# 로그인이 아직 살아 있으면 ② 는 건너뜁니다. 비밀번호는 어디에도 저장하지 않습니다.
# 증권사 세션은 몇십 분이면 끊기므로 **무인 예약으로 걸지 마십시오.**
cd "$(dirname "$0")" || exit 1
. ./파이썬고르기.sh

echo "════════════════════════════════════════════════════════"
echo "  한국투자증권 리서치 받아오기"
echo "════════════════════════════════════════════════════════"
echo
echo "── ① 새 리서치 목록 ──"
"$PY3" 한투리서치받기.py --새것 --쪽수 5 || true
echo
echo "── ② · ③ 원문 PDF ──"
"$PY3" 한투리포트받기.py
RC=$?               # 맥 기본 bash 3.2 는 한글 변수 이름을 못 씁니다
echo

if [ $RC -eq 0 ]; then
  echo "── ④ 기업 리포트를 종목 폴더로 ──"
  FILES=(입력_리포트PDF/한투_*.pdf)
  if [ -e "${FILES[0]}" ]; then
    "$PY3" 리포트넣기.py "${FILES[@]}"
  else
    echo "  종목 폴더로 넣을 기업 리포트는 없습니다."
  fi
fi

echo
echo "  받은 것은 여기 있습니다:"
echo "    입력_리포트PDF/ · 입력_산업리포트PDF/ · 입력_전략리포트PDF/"
echo
read -n 1 -s -r -p "  아무 키나 누르면 닫힙니다."
echo
